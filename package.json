{
  "name": "kakeibo-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --env-file-if-exists=.env --watch server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "chart.js": "^4.6.1",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "jsdom": "^31.0.1",
    "supertest": "^7.3.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
